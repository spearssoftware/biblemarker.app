---
import { getCollection } from 'astro:content';
import Landing from '../../layouts/Landing.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { docsNav } from '../../config/docsNav';

const docs = await getCollection('docs');
const guides = docsNav
  .flatMap(group => group.items)
  .map(item => ({
    label: item.label,
    slug: item.slug,
    description: docs.find(entry => entry.id === item.slug)?.data.description ?? '',
  }));
---

<Landing title="Docs - BibleMarker" description="Guides and reference for BibleMarker — learn inductive Bible study step by step.">
  <Nav />

  <main class="docs-index">
    <div class="container">
      <h1>Documentation</h1>
      <p class="docs-intro">Learn BibleMarker step by step — from your first study to advanced marking, analysis, and export.</p>

      <div class="guide-cards">
        {guides.map(guide => (
          <a href={`/docs/${guide.slug}/`} class="guide-card">
            <span class="card-label">{guide.label}</span>
            <span class="card-desc">{guide.description}</span>
          </a>
        ))}
      </div>
    </div>
  </main>

  <Footer />
</Landing>

<style>
  .docs-index {
    padding: 3rem 0;
  }

  .docs-index h1 {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    margin-bottom: 0.5rem;
    text-align: center;
  }

  .docs-intro {
    color: var(--color-text-muted);
    text-align: center;
    margin: 0 auto 2.5rem;
    font-size: 1.05rem;
    max-width: 600px;
  }

  .guide-cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }

  .guide-card {
    display: flex;
    flex-direction: column;
    padding: 1.25rem 1.25rem 1.4rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    text-decoration: none;
    transition: border-color 0.2s, box-shadow 0.2s;
  }

  .guide-card:hover {
    border-color: var(--color-primary);
    box-shadow: var(--shadow-md);
  }

  .card-label {
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--color-text);
    margin-bottom: 0.25rem;
  }

  .card-desc {
    font-size: 0.8rem;
    color: var(--color-text-muted);
    line-height: 1.4;
  }

  @media (max-width: 768px) {
    .guide-cards {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 480px) {
    .guide-cards {
      grid-template-columns: 1fr;
    }
  }
</style>
